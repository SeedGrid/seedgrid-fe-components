import * as React from "react";
import { CheckCircle2, FileText } from "lucide-react";
import { SgNotificationBell, registerNotificationAction } from "@seedgrid/fe-components";
import { createDemoFetcher } from "./demo-fetcher";

// O backend marca relatório e backup como abríveis (actionable); o convite continua só informativo.
const demo = createDemoFetcher(true, undefined, true);

export default function App() {
  const [opened, setOpened] = React.useState("-");

  // Cada módulo registra a ação dos tipos que emite; o sino não conhece tipo nenhum e o host não precisa de switch.
  React.useEffect(() => {
    const undoReport = registerNotificationAction("report.ready", { label: "Baixar", run: (n) => setOpened(`baixar relatório ${n.publicId}`) });
    const undoBackup = registerNotificationAction("backup.finished", { label: "Baixar", run: (n) => setOpened(`baixar backup ${n.publicId}`) });
    return () => {
      undoReport();
      undoBackup();
    };
  }, []);

  return (
    <div className="flex items-center gap-3">
      <SgNotificationBell
        fetcher={demo}
        types={{
          "report.ready": { icon: <FileText className="size-4" /> },
          "backup.finished": { icon: <CheckCircle2 className="size-4" /> }
        }}
        onOpen={(n) => setOpened((prev) => `${prev} (abriu: ${n.title})`)}
        onNotificationDelete={(n) => setOpened(`excluiu: ${n.title}`)}
      />
      <span className="text-xs text-muted-foreground">Último evento: {opened}</span>
    </div>
  );
}
