      >
        Fire 2 notices
      </SgButton>
      <div className="grid gap-4 sm:grid-cols-2">
        <div>
          <p className="mb-2 text-xs text-muted-foreground">gap: 0</p>
          <div className="rounded-xl border border-dashed border-border p-3">
            <SgWhistler max={3} gap={0} />
