        </div>
        <div>
          <p className="mb-2 text-xs text-muted-foreground">gap: 24</p>
          <div className="rounded-xl border border-dashed border-border p-3">
            <SgWhistler max={3} gap={24} />
          </div>
        </div>
      </div>
    </div>
  );
