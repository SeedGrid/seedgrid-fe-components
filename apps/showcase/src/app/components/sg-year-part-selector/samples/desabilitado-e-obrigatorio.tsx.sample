import * as React from "react";
import { SgYearPartSelector } from "@seedgrid/fe-components";

// disabled e required valem para os três controles de uma vez: o recorte é um valor único, não
// faria sentido ter o ano obrigatório e a fatia opcional.
export default function Example() {
  return (
    <div className="flex w-full max-w-xl flex-col gap-4">
      <SgYearPartSelector id="yps-disabled" label="Recorte do ano" locale="pt-BR" enabled={false} />
      <SgYearPartSelector id="yps-required" label="Recorte do ano" locale="pt-BR" required />
    </div>
  );
}
