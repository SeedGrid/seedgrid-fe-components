import * as React from "react";
import { SgYearPartSelector, YearPartKind } from "@seedgrid/fe-components";

// A sigla entre parênteses acompanha o idioma, e NÃO é a inicial do nome traduzido: trimestre é
// Q1..Q4 em pt-BR e en-US (o jargão de negócio veio do inglês) mas T1..T4 em es, fr e pt-PT, onde
// ninguém diz Q1. Semestre é S no português e H (Half-year) no inglês. Bimestre não tem sigla
// consagrada em lingua nenhuma e sai sem parênteses.
export default function Example() {
  return (
    <div className="flex w-full flex-col gap-6">
      <SgYearPartSelector
        id="yps-ptbr"
        label="pt-BR: Trimestre 1 (Q1)"
        locale="pt-BR"
        allowedKinds={[YearPartKind.QUARTER]}
      />
      <SgYearPartSelector
        id="yps-enus"
        label="en-US: Half-year 1 (H1)"
        locale="en-US"
        allowedKinds={[YearPartKind.SEMESTER]}
      />
      <SgYearPartSelector
        id="yps-es"
        label="es: Trimestre 1 (T1)"
        locale="es"
        allowedKinds={[YearPartKind.QUARTER]}
      />
    </div>
  );
}
