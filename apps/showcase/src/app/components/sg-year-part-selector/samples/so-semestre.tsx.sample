import * as React from "react";
import {
  SgYearPartSelector,
  YearPartKind,
  type ResolvedYearPart
} from "@seedgrid/fe-components";

// Com um único recorte permitido o combo do meio some: escolher entre uma opção só seria
// controle morto na tela. Sobram ano + fatia, que é o que o domínio realmente pergunta.
export default function Example() {
  const [resolved, setResolved] = React.useState<ResolvedYearPart | null>(null);

  return (
    <div className="w-full max-w-xl">
      <SgYearPartSelector
        id="yps-semester"
        label="Semestre de apuração"
        locale="pt-BR"
        allowedKinds={[YearPartKind.SEMESTER]}
        onChange={setResolved}
      />
      <p className="mt-2 text-xs text-muted-foreground">
        {resolved ? resolved.label : "Nenhum recorte confirmado ainda"}
      </p>
    </div>
  );
}
