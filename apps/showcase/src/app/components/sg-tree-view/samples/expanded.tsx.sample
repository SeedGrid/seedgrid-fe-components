import React from "react";
import { SgTreeView, type SgTreeNode } from "@seedgrid/fe-components";

const nodes: SgTreeNode[] = [
  {
    id: "root",
    label: "Admin",
    children: [
      {
        id: "users",
        label: "Usuários",
        children: [
          { id: "users.list", label: "Listar usuários" },
          { id: "users.create", label: "Criar usuário" }
        ]
      },
      {
        id: "reports",
        label: "Relatórios",
        children: [
          { id: "reports.sales", label: "Relatório de vendas" },
          { id: "reports.financial", label: "Relatório financeiro" }
        ]
      }
    ]
  }
];

export default function Example() {
  return <SgTreeView nodes={nodes} searchable searchPlaceholder="Search..." defaultExpandedIds={["root", "users"]} />;
}
