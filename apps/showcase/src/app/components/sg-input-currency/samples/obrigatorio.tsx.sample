import React from "react";
import { useForm } from "react-hook-form";
import { SgInputCurrency } from "@seedgrid/fe-components";

export default function Example() {
  const { register } = useForm();

  return (
    <>
      <SgInputCurrency
        id="demo-required"
        label="Maior que zero"
        minValue={0.01}
        name="required"
        register={register}
        currency="BRL"
      />
      <SgInputCurrency
        id="demo-required-custom"
        label="Mensagem customizada"
        minValue={0.01}
        minValueMessage="Informe um valor maior que zero."
        name="requiredCustom"
        register={register}
        currency="BRL"
      />
    </>
  );
}
