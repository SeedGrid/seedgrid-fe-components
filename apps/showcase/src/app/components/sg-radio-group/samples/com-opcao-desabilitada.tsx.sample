import React from "react";
import { SgRadioGroup, type SgRadioGroupOption } from "@seedgrid/fe-components";

const PRIORITY_OPTIONS: SgRadioGroupOption[] = [
  { label: "Baixa", value: "low" },
  { label: "Média", value: "medium" },
  { label: "Alta", value: "high" },
  { label: "Urgente", value: "urgent", enabled: false }
];

export default function Example() {
  return <SgRadioGroup id="with-disabled-option" title="Nível de prioridade" source={PRIORITY_OPTIONS} />;
}
