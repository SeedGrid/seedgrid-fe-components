import * as React from "react";
import { SgButton, SgFileUpload, SgGrid } from "@seedgrid/fe-components";

export default function App() {
  const [many, setMany] = React.useState(false);
  const [onlyDocs, setOnlyDocs] = React.useState(false);
  const [limits, setLimits] = React.useState(false);
  const [required, setRequired] = React.useState(false);
  const [disabled, setDisabled] = React.useState(false);
  const [info, setInfo] = React.useState<string | null>(null);
  const [error, setError] = React.useState<string | null>(null);

  return (
    <div className="space-y-4 p-2">
      <SgGrid columns={{ base: 3 }} gap={8}>
        <SgButton size="sm" appearance={many ? "solid" : "outline"} onClick={() => setMany((prev) => !prev)}>maxFiles 3</SgButton>
        <SgButton size="sm" appearance={onlyDocs ? "solid" : "outline"} onClick={() => setOnlyDocs((prev) => !prev)}>pdf / xlsx</SgButton>
        <SgButton size="sm" appearance={limits ? "solid" : "outline"} onClick={() => setLimits((prev) => !prev)}>limites</SgButton>
        <SgButton size="sm" appearance={required ? "solid" : "outline"} onClick={() => setRequired((prev) => !prev)}>required</SgButton>
        <SgButton size="sm" appearance={disabled ? "solid" : "outline"} onClick={() => setDisabled((prev) => !prev)}>disabled</SgButton>
      </SgGrid>

      <SgFileUpload
        key={many ? "many" : "one"}
        id="playground-file-upload"
        label="SgFileUpload Playground"
        required={required}
        disabled={disabled}
        maxFiles={many ? 3 : 1}
        mediaType={onlyDocs ? ["pdf", "xlsx"] : undefined}
        maxSizePerFile={limits ? "1MB" : undefined}
        maxSizeTotal={limits ? "2MB" : undefined}
        onChange={(files) => {
          setError(null);
          setInfo(files.length > 0 ? files.map((file) => file.name).join(", ") : null);
        }}
        onError={(code, message, fileName) => setError(`${fileName} - ${code}: ${message}`)}
      />

      <div className="rounded border border-border bg-muted/40 p-3 text-xs">
        Valor atual: <strong>{info ?? "-"}</strong>
        {error ? <div className="mt-1 text-[hsl(var(--destructive))]">{error}</div> : null}
      </div>
    </div>
  );
}
